# Copy to backend/.env and fill in. Never commit the real .env.

# MySQL: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/leadsdb

# JWT login tokens. Use a long random SECRET_KEY.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend origins allowed by CORS (comma-separated).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: tests use <DATABASE_URL db>_test unless this is set.
# TEST_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/leadsdb_test

# SMTP: kept for Phase 2 bulk email. Not used in Phase 1.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
